{
  "name": "showcase-manufacturing",
  "description": "A 3dverse powered application",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nodemon",
    "build": "run-p build:app build:server",
    "build:app": "tsc -b && vite build",
    "build:server": "tsc --project server/tsconfig.json",
    "prebuild": "run-s typegen libgen",
    "typegen": "mkdir -p _prebuild/api-types && npm run typegen:all ",
    "typegen:all": "run-p typegen:aps typegen:eam typegen:erp typegen:mes typegen:qms typegen:wms",
    "typegen:aps": "openapi typegen --backend server/spec/APS.yaml > _prebuild/api-types/aps.d.ts",
    "typegen:eam": "openapi typegen --backend server/spec/EAM.yaml > _prebuild/api-types/eam.d.ts",
    "typegen:erp": "openapi typegen --backend server/spec/ERP.yaml > _prebuild/api-types/erp.d.ts",
    "typegen:mes": "openapi typegen --backend server/spec/MES.yaml > _prebuild/api-types/mes.d.ts",
    "typegen:qms": "openapi typegen --backend server/spec/QMS.yaml > _prebuild/api-types/qms.d.ts",
    "typegen:wms": "openapi typegen --backend server/spec/WMS.yaml > _prebuild/api-types/wms.d.ts",
    "libgen": "mkdir -p _prebuild/api-libs && npm run libgen:all",
    "libgen:all": "run-p libgen:aps libgen:eam libgen:erp libgen:mes libgen:qms libgen:wms",
    "libgen:aps": "openapi-generator-cli generate -c server/libs/aps-api.json -o _prebuild/api-libs/aps",
    "libgen:eam": "openapi-generator-cli generate -c server/libs/eam-api.json -o _prebuild/api-libs/eam",
    "libgen:erp": "openapi-generator-cli generate -c server/libs/erp-api.json -o _prebuild/api-libs/erp",
    "libgen:mes": "openapi-generator-cli generate -c server/libs/mes-api.json -o _prebuild/api-libs/mes",
    "libgen:qms": "openapi-generator-cli generate -c server/libs/qms-api.json -o _prebuild/api-libs/qms",
    "libgen:wms": "openapi-generator-cli generate -c server/libs/wms-api.json -o _prebuild/api-libs/wms",
    "typecheck": "npm run typegen && npm run libgen && tsc -p ./server/tsconfig.json && tsc -p tsconfig.app.json",
    "lint": "eslint .",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@3dverse/api": "^0.8.14",
    "@3dverse/livelink": "^0.8.61",
    "@3dverse/livelink-react": "^0.2.63",
    "@3dverse/livelink-react-ui": "^0.3.20",
    "@3dverse/logger": "^0.1.3",
    "@3dverse/service-common-errors": "^0.7.2",
    "@3dverse/service-environment": "^0.1.2",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/pro-light-svg-icons": "^7.1.0",
    "@fortawesome/pro-solid-svg-icons": "^7.1.0",
    "@fortawesome/pro-thin-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@fortawesome/sharp-light-svg-icons": "^7.1.0",
    "@fortawesome/sharp-regular-svg-icons": "^7.1.0",
    "@fortawesome/sharp-solid-svg-icons": "^7.1.0",
    "@tailwindcss/vite": "^4.1.5",
    "@types/yamljs": "^0.2.34",
    "@visx/axis": "^3.12.0",
    "@visx/curve": "^3.12.0",
    "@visx/grid": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/responsive": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "@visx/tooltip": "^3.12.0",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "d3": "^7.9.0",
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "framer-motion": "^12.35.0",
    "http-proxy-middleware": "^3.0.5",
    "openapi-backend": "^5.16.1",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "react-gauge-component": "^2.0.26",
    "react-icons": "^5.5.0",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.4.0",
    "yamljs": "^0.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@eslint/js": "^9.25.0",
    "@fortawesome/fontawesome-common-types": "^7.1.0",
    "@openapitools/openapi-generator-cli": "^2.30.2",
    "@storybook/addon-a11y": "^10.2.8",
    "@storybook/addon-docs": "^10.2.8",
    "@storybook/addon-vitest": "^10.2.8",
    "@storybook/react-vite": "^10.2.8",
    "@types/compression": "^1.8.1",
    "@types/node": "^25.2.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "openapicmd": "^2.9.0",
    "path": "^0.12.7",
    "playwright": "^1.58.2",
    "prettier": "^3.4.2",
    "slugify": "^1.6.8",
    "storybook": "^10.2.8",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^4.0.18"
  }
}
